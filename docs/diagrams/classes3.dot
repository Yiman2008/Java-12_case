digraph G {
graph [rankdir=LR, fontname="Liberation Sans", fontsize=12, nodesep=0.3, ranksep=0.5, newrank=true, pad=0.2, bgcolor=white];
node [shape=plain, fontname="Liberation Sans", fontsize=11];
edge [fontname="Liberation Sans", fontsize=10, color="#222222", arrowsize=0.9, labeldistance=1.6, labelangle=30];
subgraph cluster_data { label=<<B>data</B>>; labeljust=l; style="rounded"; color="#9aa3b2"; bgcolor="#fbfbf7";
  TableCatalog [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>TableCatalog</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- cache: Map&lt;Path, Table&gt;<BR/>- baseDir: Path</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ resolve(name: String): Table</TD></TR></TABLE>>];
  CsvReader [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>CsvReader</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- delimiter: char<BR/>- charset: Charset<BR/>- hasHeader: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ read(path: Path): Table<BR/>- inferTypes(raw): Schema</TD></TR></TABLE>>];
  Table [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>Table</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ name: String<BR/>+ schema: Schema<BR/>+ rows: List&lt;Row&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  Schema [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>Schema</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- columns: List&lt;Column&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ indexOf(name: String): int</TD></TR></TABLE>>];
  Column [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>Column</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ name: String<BR/>+ type: DataType</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  DataType [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><FONT POINT-SIZE="10"><I>«enumeration»</I></FONT><BR/><B>DataType</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">INTEGER, DECIMAL, STRING,<BR/>BOOLEAN, DATE, NULL</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  Row [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>Row</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- values: Value[]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ get(i: int): Value</TD></TR></TABLE>>];
  Value [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>Value</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- type: DataType<BR/>- raw: Object</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ compareTo(o: Value): int<BR/>+ asNumber(): BigDecimal</TD></TR></TABLE>>];
}
ReportEngine [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>ReportEngine</B></TD></TR></TABLE>>];
QueryPlanner [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>QueryPlanner</B></TD></TR></TABLE>>];
ScanOperator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>ScanOperator</B></TD></TR></TABLE>>];
ReportEngine -> TableCatalog [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1"];
ReportEngine -> QueryPlanner [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1"];
QueryPlanner -> TableCatalog [arrowhead=vee, headlabel="1", taillabel=""];
ScanOperator -> Table [arrowhead=vee, headlabel="1", taillabel=""];
TableCatalog -> Table [dir=both, arrowtail=odiamond, arrowhead=none, headlabel="0..*"];
TableCatalog -> CsvReader [arrowhead=vee, style=dashed, label="«use»", fontsize=10];
CsvReader -> Table [arrowhead=vee, style=dashed, label="«create»", fontsize=10];
Table -> Schema [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1"];
Table -> Row [dir=both, arrowtail=diamond, arrowhead=none, headlabel="0..*"];
Schema -> Column [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1..*"];
Column -> DataType [arrowhead=vee, headlabel="1", taillabel=""];
Row -> Value [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1..*"];
}