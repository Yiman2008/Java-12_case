digraph G {
graph [rankdir=TB, fontname="Liberation Sans", fontsize=12, nodesep=0.3, ranksep=0.5, newrank=true, pad=0.2, bgcolor=white];
node [shape=plain, fontname="Liberation Sans", fontsize=11];
edge [fontname="Liberation Sans", fontsize=10, color="#222222", arrowsize=0.9, labeldistance=1.6, labelangle=30];
subgraph cluster_exec { label=<<B>execution</B>>; labeljust=l; style="rounded"; color="#9aa3b2"; bgcolor="#fbfbf7";
  QueryPlanner [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>QueryPlanner</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ plan(s: SelectStatement, c: TableCatalog): Operator<BR/>- validate(s, schema): void</TD></TR></TABLE>>];
  Operator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><FONT POINT-SIZE="10"><I>«interface»</I></FONT><BR/><B>Operator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ open(): void<BR/>+ next(): Row<BR/>+ close(): void<BR/>+ schema(): Schema</TD></TR></TABLE>>];
  ScanOperator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>ScanOperator</B></TD></TR></TABLE>>];
  FilterOperator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>FilterOperator</B></TD></TR></TABLE>>];
  JoinOperator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>JoinOperator</B></TD></TR></TABLE>>];
  AggregateOperator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>AggregateOperator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- groupBy: List&lt;Expression&gt;<BR/>- groups: Map&lt;Key, Accs&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR></TABLE>>];
  SortOperator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>SortOperator</B></TD></TR></TABLE>>];
  ProjectOperator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>ProjectOperator</B></TD></TR></TABLE>>];
  LimitOperator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>LimitOperator</B></TD></TR></TABLE>>];
  AggregateFunction [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><FONT POINT-SIZE="10"><I>«interface»</I></FONT><BR/><B>AggregateFunction</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ accumulate(v: Value): void<BR/>+ result(): Value</TD></TR></TABLE>>];
  FunctionRegistry [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>FunctionRegistry</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- factories: Map&lt;String, Supplier&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ register(name, f): void<BR/>+ create(name): AggregateFunction</TD></TR></TABLE>>];
  Count [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>Count</B></TD></TR></TABLE>>];
  Sum [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>Sum</B></TD></TR></TABLE>>];
  Avg [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>Avg</B></TD></TR></TABLE>>];
  Min [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>Min</B></TD></TR></TABLE>>];
  Max [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>Max</B></TD></TR></TABLE>>];
}
ReportEngine [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>ReportEngine</B></TD></TR></TABLE>>];
SemanticException [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>SemanticException</B></TD></TR></TABLE>>];
TableCatalog [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>TableCatalog</B></TD></TR></TABLE>>];
Table [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#222222"><TR><TD BGCOLOR="#e9eef6" CELLPADDING="4"><B>Table</B></TD></TR></TABLE>>];
ReportEngine -> TableCatalog [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1"];
ReportEngine -> FunctionRegistry [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1"];
ReportEngine -> QueryPlanner [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1"];
QueryPlanner -> Operator [arrowhead=vee, style=dashed, label="«create»", fontsize=10];
QueryPlanner -> SemanticException [arrowhead=vee, style=dashed, label="«throw»", fontsize=10];
QueryPlanner -> TableCatalog [arrowhead=vee, headlabel="1", taillabel=""];
ScanOperator -> Operator [arrowhead=onormal, style=dashed];
FilterOperator -> Operator [arrowhead=onormal, style=dashed];
JoinOperator -> Operator [arrowhead=onormal, style=dashed];
AggregateOperator -> Operator [arrowhead=onormal, style=dashed];
SortOperator -> Operator [arrowhead=onormal, style=dashed];
ProjectOperator -> Operator [arrowhead=onormal, style=dashed];
LimitOperator -> Operator [arrowhead=onormal, style=dashed];
FilterOperator -> Operator [dir=both, arrowtail=odiamond, arrowhead=none, headlabel="1"];
ScanOperator -> Table [arrowhead=vee, headlabel="1", taillabel=""];
AggregateOperator -> AggregateFunction [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1..*"];
AggregateOperator -> FunctionRegistry [arrowhead=vee, style=dashed];
Count -> AggregateFunction [arrowhead=onormal, style=dashed];
Sum -> AggregateFunction [arrowhead=onormal, style=dashed];
Avg -> AggregateFunction [arrowhead=onormal, style=dashed];
Min -> AggregateFunction [arrowhead=onormal, style=dashed];
Max -> AggregateFunction [arrowhead=onormal, style=dashed];
TableCatalog -> Table [dir=both, arrowtail=odiamond, arrowhead=none, headlabel="0..*"];
}